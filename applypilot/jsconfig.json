{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "src/**/*",
    "server/**/*",
    "server.js",
    "vite.config.js"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
