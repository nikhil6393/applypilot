{
  "watch": [
    "server.js",
    "server",
    "shared"
  ],
  "ext": "js,ts,json",
  "ignore": [
    "data/**",
    "scratch/**",
    "dist/**",
    "tests/**",
    "test-results/**",
    "node_modules/**",
    "*.db*",
    "*.sqlite*",
    "*.log"
  ],
  "exec": "tsx --max-old-space-size=4096 server.js"
}

